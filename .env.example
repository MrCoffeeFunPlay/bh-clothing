# Optional. The site already uses the BH Supabase project's public browser settings (src/catalogStore.ts).
# Set these only to point the site at a different Supabase project. Use the publishable (sb_publishable_...) key.
# Never put a secret, service_role or database password in a VITE_ variable: everything VITE_ ends up in the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
